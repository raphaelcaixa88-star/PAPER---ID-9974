clear all;
close all;
clc;

%Caracterização do sinal
y1=load('.txt');
fs = 500; % find the sampling rate or frequency
T = 1/fs;% sampling rate or frequency
% find the length of the data per second
N = length(y1);
ls = size(y1);
t = (0 : N-1)/fs;% sampling period

%Caracterização do sinal
y2=load('.txt');
fs2 = 500; % find the sampling rate or frequency
T2 = 1/fs2;% sampling rate or frequency
% find the length of the data per second
N2 = length(y2);
ls2 = size(y2);
t2 = (0 : N2-1)/fs2;% sampling period

%%%%%%%% FILTROS PASSA BAIXA E PASSA ALTA

[bl,al]=butter(4,35.0/250);
y11=filtfilt(bl,al,y1);%low-pass
[bh,ah]=butter(4,18/250,'high');
y12=filtfilt(bh,ah,y11);%high-pass

[bl2,al2]=butter(4,40.0/250);
y112=filtfilt(bl2,al2,y2);%low-pass
[bh2,ah2]=butter(4,18.0/250,'high');
y122=filtfilt(bh2,ah2,y112);%high-pass


%%%%%%%% FILTRO NOT///CH 60HZ

d = designfilt('bandstopiir','FilterOrder',2, ...
               'HalfPowerFrequency1',58,'HalfPowerFrequency2',61, ...
               'DesignMethod','butter','SampleRate',fs);
           buttLoop =filtfilt(d,y12);
           
           j = designfilt('bandstopiir','FilterOrder',4, ...
               'HalfPowerFrequency1',58,'HalfPowerFrequency2',61, ...
               'DesignMethod','butter','SampleRate',fs2);
           buttLoop2 =filtfilt(j,y122);
                      
%%%%%%%% LINHA DE BASE DO SINAL           

[p,s,mu] = polyfit((1:numel(buttLoop))',buttLoop,6);
f_y = polyval(p,(1:numel(buttLoop))',[],mu);

ECG_data = buttLoop - f_y;        % Detrend data


[p2,s2,mu2] = polyfit((1:numel(buttLoop2))',buttLoop2,6);
f_y2 = polyval(p2,(1:numel(buttLoop2))',[],mu2);

ECG_data2 = buttLoop2 - f_y2;        % Detrend data

   
subplot(2,1,1)
plot(t,ECG_data)% grid
legend('')
axis([]);



